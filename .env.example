# Copy to .env and fill in only what you use. Never commit .env.

# Dev LLM: Gemini API (free tier)
GEMINI_API_KEY=

# Final-run / judge LLMs (which one is TBD, see configs/models.yaml)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Local models through Ollama's OpenAI-compatible endpoint
OLLAMA_BASE_URL=http://localhost:11434/v1

# Optional: Hugging Face token (higher download rate limits)
HF_TOKEN=

# Optional: keep the Hugging Face model cache inside the project (git-ignored)
# HF_HOME=.cache/huggingface

# Optional: Neo4j, only if the NetworkX graph is mirrored to Neo4j
# NEO4J_URI=bolt://localhost:7687
# NEO4J_USER=neo4j
# NEO4J_PASSWORD=
